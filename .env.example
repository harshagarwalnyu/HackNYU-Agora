###########################################
# Agora Environment (Backend + Compose)
# SOTA Open Source Stack: Groq (Llama/Whisper), EdgeTTS, Qdrant
###########################################

# API Keys (Required)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# LOG_FILE=app.log

# Qdrant Configuration (Vector Database)
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# LLM Configuration (Groq - Llama/DeepSeek)
# Supported: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# STT Provider (Groq Whisper)
STT_PROVIDER=groq_whisper
STT_MODEL=whisper-large-v3

# TTS Provider (Edge TTS - High Quality Open Usage)
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-AriaNeural

# Frontend Configuration (Public)
NEXT_PUBLIC_WS_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
